rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ═══════════════════════════════════════════════════
    // ✅ FUNCIONES AUXILIARES
    // ═══════════════════════════════════════════════════
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return request.auth != null && 
             request.auth.uid != null &&
             exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: admin
    // ═══════════════════════════════════════════════════
    match /admin/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow write: if false;
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: sellers
    // ═══════════════════════════════════════════════════
    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: matches
    // ═══════════════════════════════════════════════════
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: match_results
    // ═══════════════════════════════════════════════════
    match /match_results/{resultId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: tickets
    // ═══════════════════════════════════════════════════
    match /tickets/{ticketId} {
      // Admin: acceso total
      allow read, write, delete, update: if isAdmin();
      
      // Vendedor: solo puede acceder a SUS propios tickets (sellerId == UID de Auth)
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: pending_tickets
    // ═══════════════════════════════════════════════════
    match /pending_tickets/{ticketId} {
      allow create: if 
        request.resource.data.keys().hasAll([
          'customerName', 
          'customerPhone', 
          'sellerId', 
          'sellerName', 
          'bets', 
          'totalStake', 
          'status'
        ]) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.totalStake == 5000 &&
        request.resource.data.bets.size() == 7;
      
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 BLOQUEO TOTAL
    // ═══════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}