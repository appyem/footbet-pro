rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ═══════════════════════════════════════════════════
    // ✅ FUNCIONES AUXILIARES
    // ═══════════════════════════════════════════════════
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }
    
    function isSellerOf(sellerDocId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/sellers/$(sellerDocId)) &&
             get(/databases/$(database)/documents/sellers/$(sellerDocId)).data.uid == request.auth.uid;
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: admin
    // ═══════════════════════════════════════════════════
    match /admin/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow write: if false;
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: sellers
    // ═══════════════════════════════════════════════════
    match /sellers/{sellerId} {
      // ✅ PÚBLICO puede leer TODOS los vendedores activos
      allow read: if true;
      
      // Admin: acceso completo
      allow write: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: matches
    // ═══════════════════════════════════════════════════
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: match_results
    // ═══════════════════════════════════════════════════
    match /match_results/{resultId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: tickets
    // ═══════════════════════════════════════════════════
    match /tickets/{ticketId} {
      allow read, write: if isAdmin();
      allow create: if isSellerOf(request.resource.data.sellerId);
      allow read: if isSellerOf(resource.data.sellerId);
      allow delete: if isSellerOf(resource.data.sellerId);
      allow update: if isSellerOf(resource.data.sellerId);
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: pending_tickets
    // ═══════════════════════════════════════════════════
    match /pending_tickets/{ticketId} {
      allow create: if 
        request.resource.data.keys().hasAll([
          'customerName', 
          'customerPhone', 
          'sellerId', 
          'sellerName', 
          'bets', 
          'totalStake', 
          'status'
        ]) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.totalStake == 5000 &&
        request.resource.data.bets.size() == 7;
      
      allow read, write: if isAdmin();
      allow read: if isSellerOf(resource.data.sellerId);
      allow update, delete: if isSellerOf(resource.data.sellerId);
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 BLOQUEO TOTAL
    // ═══════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
