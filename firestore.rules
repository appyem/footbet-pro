rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ═══════════════════════════════════════════════════
    // ✅ FUNCIONES AUXILIARES
    // ═══════════════════════════════════════════════════
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return request.auth != null && 
             request.auth.uid != null &&
             exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: admin
    // ═══════════════════════════════════════════════════
    match /admin/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow write: if false;
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: sellers
    // ═══════════════════════════════════════════════════
    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: matches
    // ═══════════════════════════════════════════════════
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: match_results
    // ═══════════════════════════════════════════════════
    match /match_results/{resultId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: tickets
    // ═══════════════════════════════════════════════════
    match /tickets/{ticketId} {
      // Admin: acceso total a TODOS los tickets
      allow read, write, delete, update: if isAdmin();
      
      // Vendedor: crea tickets con su UID como sellerId
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      
      // Vendedor: lee solo SUS propios tickets
      allow read: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
      
      // Vendedor: elimina y actualiza solo SUS propios tickets
      allow delete: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
      
      // 🆕 PÚBLICO: Cliente puede leer tickets filtrando por su número de teléfono
      // Esto permite que el componente ClientResults funcione sin autenticación
      allow read: if true;
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: pending_tickets
    // ═══════════════════════════════════════════════════
    match /pending_tickets/{ticketId} {
      allow create: if 
        request.resource.data.keys().hasAll([
          'customerName', 'customerPhone', 'sellerId', 'sellerName', 
          'bets', 'totalStake', 'status'
        ]) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.totalStake == 5000 &&
        request.resource.data.bets.size() == 7;
      
      // Admin: acceso total
      allow read, write, delete, update: if isAdmin();
      
      // Vendedor: solo puede acceder a SUS propios tickets pendientes
      allow read: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
    }
    
        // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: client_uids
    // ═══════════════════════════════════════════════════
    match /client_uids/{uidId} {
      // Público: puede leer para validar código de acceso
      allow read: if true;
      
      // Solo Cloud Functions (admin) puede escribir
      // Los clientes NO pueden crear, modificar ni eliminar UIDs
      allow write: if isAdmin();
    }
    
    
        // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: client_prizes (Premios de clientes)
    // ═══════════════════════════════════════════════════
    match /client_prizes/{phone} {
      // Público: puede leer para ver sus premios disponibles
      allow read: if true;
      
      // Solo Cloud Functions (admin) puede escribir
      // Los clientes NO pueden crear, modificar ni eliminar premios
      allow write: if isAdmin();
    }
    

    // ═══════════════════════════════════════════════════
    // 🔒 BLOQUEO TOTAL (cualquier otra colección)
    // ═══════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}