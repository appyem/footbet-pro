rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ═══════════════════════════════════════════════════
    // ✅ FUNCIONES AUXILIARES
    // ═══════════════════════════════════════════════════
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return request.auth != null && 
             request.auth.uid != null &&
             exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: admin
    // ═══════════════════════════════════════════════════
    match /admin/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow write: if false;
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: sellers
    // ═══════════════════════════════════════════════════
    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: matches
    // ═══════════════════════════════════════════════════
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: match_results
    // ═══════════════════════════════════════════════════
    match /match_results/{resultId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: tickets
    // ═══════════════════════════════════════════════════
    match /tickets/{ticketId} {
      allow read, write, delete, update: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
      allow read: if true;
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: pending_tickets
    // ═══════════════════════════════════════════════════
    match /pending_tickets/{ticketId} {
      allow create: if 
        request.resource.data.keys().hasAll([
          'customerName', 'customerPhone', 'sellerId', 'sellerName', 
          'bets', 'totalStake', 'status'
        ]) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.totalStake == 5000 &&
        request.resource.data.bets.size() == 7;
      
      allow read, write, delete, update: if isAdmin();
      allow read: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: client_uids
    // ═══════════════════════════════════════════════════
    match /client_uids/{uidId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════
    // 🔒 COLECCIÓN: client_prizes (Premios de clientes)
    // ═══════════════════════════════════════════════════
    match /client_prizes/{phone} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════
    // 🆕 COLECCIÓN: client_balances (Saldos de créditos)
    // ═══════════════════════════════════════════════════
    match /client_balances/{phone} {
      // Cliente puede leer su propio saldo
      allow read: if true;
      
      // Solo Cloud Functions (admin) puede escribir
      allow write: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════
    // 🆕 COLECCIÓN: transactions (Historial de transacciones)
    // ═══════════════════════════════════════════════════
    match /transactions/{transactionId} {
      // Cliente puede leer sus propias transacciones
      allow read: if true;
      
      // Solo Cloud Functions (admin) puede escribir
      allow write: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════
    // 🆕 COLECCIÓN: withdrawal_requests (Solicitudes de retiro/recarga)
    // ═══════════════════════════════════════════════════
    match /withdrawal_requests/{requestId} {
      // Cliente puede leer sus propias solicitudes
      allow read: if true;
      
      // Cliente puede crear solicitudes (recargas y retiros)
      allow create: if request.resource.data.keys().hasAll([
        'phone', 'type', 'amount', 'status'
      ]) && request.resource.data.status == 'pending';
      
      // Solo Cloud Functions (admin) puede actualizar/eliminar
      allow update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════
    // 🔒 BLOQUEO TOTAL (cualquier otra colección)
    // ═══════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}